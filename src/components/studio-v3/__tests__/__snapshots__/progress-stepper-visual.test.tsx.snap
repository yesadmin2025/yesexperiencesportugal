// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StudioV3ProgressStepper — visual contract > snapshot: active chapter DOM shape stays locked 1`] = `"<nav aria-label="Studio progress" data-testid="studio-v3-progress-stepper" data-active-beat="rhythm" class="mt-4 mb-1 flex w-full items-center justify-between gap-2 pl-5 pr-16 sm:pr-12"><div class="flex min-h-[44px] flex-1 flex-col items-center justify-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="region" data-state="done"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--gold) 55%, transparent);"></span><span class="t-eyebrow whitespace-nowrap text-[11px] sm:text-[11px]" style="color: var(--charcoal);">You</span></div><div class="flex min-h-[44px] flex-1 flex-col items-center justify-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="rhythm" data-state="active" aria-current="step"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: var(--gold);"></span><span class="t-eyebrow whitespace-nowrap text-[11px] sm:text-[11px]" style="color: var(--charcoal);">Your day</span></div><div class="flex min-h-[44px] flex-1 flex-col items-center justify-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="compose" data-state="upcoming"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--charcoal) 12%, transparent);"></span><span class="t-eyebrow whitespace-nowrap text-[11px] sm:text-[11px]" style="color: color-mix(in oklab, var(--charcoal) 55%, transparent);">Make it yours</span></div></nav>"`;
