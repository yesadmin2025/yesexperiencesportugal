// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StudioV3ProgressStepper — visual contract > snapshot: active-beat=dates DOM shape stays locked 1`] = `"<nav aria-label="Studio progress" data-testid="studio-v3-progress-stepper" data-active-beat="dates" class="mt-4 mb-1 flex w-full items-center justify-between gap-2 pl-5 pr-16 sm:pr-12"><div class="flex flex-1 flex-col items-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="region" data-state="done"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--gold) 55%, transparent);"></span><span class="text-[10px] uppercase tracking-[0.16em] font-semibold whitespace-nowrap" style="font-family: var(--font-editorial); color: var(--charcoal);">Feel</span></div><div class="flex flex-1 flex-col items-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="rhythm" data-state="done"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--gold) 55%, transparent);"></span><span class="text-[10px] uppercase tracking-[0.16em] font-semibold whitespace-nowrap" style="font-family: var(--font-editorial); color: var(--charcoal);">Taste</span></div><div class="flex flex-1 flex-col items-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="dates" data-state="active" aria-current="step"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: var(--gold);"></span><span class="text-[10px] uppercase tracking-[0.16em] font-semibold whitespace-nowrap" style="font-family: var(--font-editorial); color: var(--charcoal);">Shape</span></div><div class="flex flex-1 flex-col items-center gap-1.5" data-testid="studio-v3-phase-tab" data-beat="compose" data-state="upcoming"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--charcoal) 12%, transparent);"></span><span class="text-[10px] uppercase tracking-[0.16em] font-semibold whitespace-nowrap" style="font-family: var(--font-editorial); color: color-mix(in oklab, var(--charcoal) 55%, transparent);">Your day</span></div></nav>"`;
