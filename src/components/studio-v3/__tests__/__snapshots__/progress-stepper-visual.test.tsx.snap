// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StudioV3ProgressStepper — visual contract > snapshot: active-beat=dates DOM shape stays locked 1`] = `"<nav aria-label="Studio progress" data-testid="studio-v3-progress-stepper" data-active-beat="dates" class="mx-auto mt-4 mb-2 flex w-full max-w-[440px] items-center justify-between gap-2 px-5"><div class="flex flex-1 flex-col items-center gap-1.5" data-beat="region" data-state="done"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--gold) 55%, transparent);"></span><span class="text-[9.5px] uppercase tracking-[0.22em] font-semibold" style="font-family: var(--font-display); color: var(--charcoal);">Region</span></div><div class="flex flex-1 flex-col items-center gap-1.5" data-beat="rhythm" data-state="done"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--gold) 55%, transparent);"></span><span class="text-[9.5px] uppercase tracking-[0.22em] font-semibold" style="font-family: var(--font-display); color: var(--charcoal);">Rhythm</span></div><div class="flex flex-1 flex-col items-center gap-1.5" data-beat="dates" data-state="active" aria-current="step"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: var(--gold);"></span><span class="text-[9.5px] uppercase tracking-[0.22em] font-semibold" style="font-family: var(--font-display); color: var(--charcoal);">Dates</span></div><div class="flex flex-1 flex-col items-center gap-1.5" data-beat="compose" data-state="upcoming"><span aria-hidden="true" class="block h-[3px] w-full rounded-full transition-colors duration-300" style="background: color-mix(in oklab, var(--charcoal) 12%, transparent);"></span><span class="text-[9.5px] uppercase tracking-[0.22em] font-semibold" style="font-family: var(--font-display); color: color-mix(in oklab, var(--charcoal) 55%, transparent);">Compose</span></div></nav>"`;
